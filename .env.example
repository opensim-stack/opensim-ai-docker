# Minimum configuration for the very fatally impatient.
#
# !!!! YOU MUST CHANGE AT LEAST THE HOSTNAME BELOW !!!!!"
#
# VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV 
OPENSIM_HOSTNAME=${OPENSIM_HOSTNAME:-opensim}
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

# First-run provisioning mode.
#    guided - Do not start any bots or simulators, instead the user is expected
#             to use the web-based guided setup to configure the grid and
#              create a bot user.
#    auto   - Automatically create a standalone simulator, region and bot user
#    grid   - Automatically create a robus service, grid simulator, regiona bot user
OPENSIM_PROVISION_MODE=${OPENSIM_PROVISION_MODE:-guided}

# If you use `auto` or `grid` provisioning mode, the following values will be used to
# create the initial simulators, region, estate an dbot user. You can change these 
# values to whatever you like, but make sure you change the password to something secure.

OPENSIM_ESTATE_NAME=Botland
OPENSIM_ESTATE_ARCHIVE=blank
OPENSIM_REGION_X=1000
OPENSIM_REGION_Y=1000
OPENSIM_GRID_NAME=Bot Grid
OPENSIM_GRID_NICK=botgrid
OPENSIM_WELCOME_MESSAGE="Welcome to ${OPENSIM_GRID_NAME:-Bot Grid}!"
OPENSIM_USER_EMAIL=admin@example.com
OPENSIM_USER_FIRST=Bot
OPENSIM_USER_LAST=Handler
OPENSIM_USER_PASSWORD=changeme

# If you want to create a bot user on first startup, set this to true and provide the following details. Otherwise, leave it false and create your bot user manually.
OPENSIM_CREATE_BOT_USER=true
OPENSIM_BOT_FIRST=Governor
OPENSIM_BOT_LAST=Bot
OPENSIM_BOT_EMAIL=bot@localhost
OPENSIM_BOT_APPEARANCE=Cube Bot
OPENSIM_BOT_GENDER=neutral

# Basic configuration
#
# If you have a little more time, or are in any way security concious,
# setting the basic configuration is the way to go. 
# 
# Note, these cannot be changed here after first run, so make sure you set passwords
# to something secure. See documentation for how to change after initial setup.
# 

# Docker
COMPOSE_PROJECT_NAME=opensim-ai
OPENSIM_PULL_POLICY=missing

# Network 
OPENSIM_NETWORK="${COMPOSE_PROJECT_NAME:-opensim-ai}-network"
OPENSIM_REGION_PORT=9000
OPENSIM_ROBUST_PUBLIC_PORT=8002
OPENSIM_ROBUST_PRIVATE_PORT=8003
OPENSIM_GRID_SERVICES="${COMPOSE_PROJECT_NAME:-opensim-ai}-grid-services"

# Basic Stack Credentials
MARIADB_PASSWORD=opensimpassword
MARIADB_ROOT_PASSWORD=rootpassword
OPENSIM_CONSOLE_USER=ConsoleUser
OPENSIM_CONSOLE_PASS=ConsolePass

# ADVANCED CONFIGURATION
#
# Anything below this line is optional and can be left as-is for most users.


# ---------------------------
# IMAGE REFERENCES
# --------------------------

OPENSIM_JANUS_IMAGE=misterblue/os-webrtc-janus-docker:latest
OPENSIM_OPENCODE_IMAGE=bithatch/opensim-opencode:latest
OPENSIM_PIPER_IMAGE=bithatch/opensim-piper:latest
OPENSIM_BLENDER_IMAGE=bithatch/opensim-blender:latest
OPENSIM_METAVERSE2MCP_IMAGE=bithatch/opensim-metaverse2mcp:latest
OPENSIM_SPAWNER_IMAGE=bithatch/opensim-spawner:latest
OPENSIM_CONSOLE2MCP_IMAGE=bithatch/opensim-console2mcp:latest
OPENSIM_SIMULATOR_IMAGE=bithatch/opensim-simulator:latest

OPENSIM_SOURCE_IMAGE=bithatch/opensim-ai-standalone:dev-latest
OPENSIM_RELEASE_IMAGE=bithatch/opensim-ai-standalone:latest

# ---------------------------
# MODE SELECTION
# ---------------------------

# Used by docker-compose.yml (source build from git clone)
OPENSIM_GIT_URL=git://opensimulator.org/git/opensim
OPENSIM_GIT_REF=master

# Used by docker-compose.release.yml (official OpenSimulator binary release)
OPENSIM_RELEASE_REF=r78cb44c
OPENSIM_RELEASE_URL=https://github.com/opensim/opensim/releases/download/${OPENSIM_RELEASE_REF}/LastDotNetBuild.zip

# ---------------------------
# Console MCP configuration
# ---------------------------

CONSOLE_MCP_TRANSPORT=http
CONSOLE_MCP_HOST=0.0.0.0
CONSOLE_MCP_PORT=8997
OPENSIM_CONSOLE_URL="http://${OPENSIM_GRID_SERVICES}:9000"

# ---------------------------
# Spawner service
# ---------------------------

OPENSIM_SPAWNER_HTTP_PORT=8993
OPENSIM_SPAWNER_HTTP_HOST=0.0.0.0
OPENSIM_SPAWNER_TOKEN=
OPENSIM_SPAWNER_FIRST_PORT=9000
SPAWNER_HOST=${COMPOSE_PROJECT_NAME:-opensim-ai}-spawner-1

# ---------------------------
# Metaverse2MCP  service
# ---------------------------

OPENSIM_LOGIN_URI="http://${OPENSIM_GRID_SERVICES}:9000"
OPENSIM_LOGIN_START=last
OPENSIM_LOGIN_TIMEOUT_SECONDS=30
OPENSIM_HANDLER_CONFIG=/config/handlers.json
METAVERSE_MCP_TRANSPORT=http
METAVERSE_MCP_HOST=0.0.0.0
METAVERSE_MCP_PORT=8999
METAVERSE_MCP_HTTP_ENDPOINT=/mcp
METAVERSE_MCP_HTTP_DISALLOW_DELETE=false
METAVERSE_MCP_DIAGNOSTICS=false
PROMPT_HANDLING_ENABLED=true
PROMPT_PROJECT_AGENTS_ENABLED=true
PROMPT_NOTECARD_REQUIRE_HANDLER=true
METAVERSE_BRIDGE_TRUST_STATE_FILE=/config/bridges/dialog-bridge-trust-{bot_uuid}.json

# ---------------------------
# Blender service
# ---------------------------

BLENDER_MCP_HOST=0.0.0.0
BLENDER_MCP_PORT=8996
BLENDER_TCP_PROTOCOL_HOST=127.0.0.1
BLENDER_TCP_PROTOCOL_PORT=9876
BLENDER_PROJECT_DIR=/workspace
BLENDER_EXTRA_ARGS=

# ---------------------------
# Piper TTS service
# ---------------------------

PIPEE_HOST=${COMPOSE_PROJECT_NAME:-opensim-ai}-piper-1
PIPER_HTTP_HOST=0.0.0.0
PIPER_HTTP_PORT=8995
PIPER_DEFAULT_VOICE=en_US-lessac-medium
PIPER_TIMEOUT_SECONDS=60

# ---------------------------
# Opencode server service
# ---------------------------

OPENCODE_SCHEME=http
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
OPENCODE_INITIAL_PROVIDER=
OPENCODE_INITIAL_MODEL=
OPENCODE_REQUEST_TIMEOUT_SECONDS=1800
OPENCODE_HOST=0.0.0.0
OPENCODE_PORT=8998
OPENCODE_PROJECT_DIR=/workspace
OPENCODE_SERVER_EXTRA_ARGS=
OPENCODE_BLENDER_MCP_URL="http://${COMPOSE_PROJECT_NAME:-opensim-ai}-blender:8996/mcp"
OPENCODE_PIPER_URL="http://${COMPOSE_PROJECT_NAME:-opensim-ai}-piper:8995"

# ---------------------------
# Janus WebRTC voice service
# ---------------------------

OPENSIM_WEBRTC_VOICE_ENABLED=true

# Hostname returned to viewers/simulator for Janus gateway access.
# Use a DNS name or public IP reachable by your viewers.
OPENSIM_JANUS_PUBLIC_HOST=${OPENSIM_HOSTNAME}

JANUS_SERVER_NAME=GridVoice
JANUS_HTTP_ENABLE=true
JANUS_HTTP_PORT=14223
JANUS_HTTP_BASEPATH=/voice
JANUS_HTTPS_ENABLE=false
JANUS_HTTPS_PORT=14224
JANUS_HTTP_ADMIN_ENABLE=true
JANUS_HTTP_ADMIN_PORT=14225
JANUS_HTTP_ADMIN_BASEPATH=/voiceAdmin
JANUS_UDP_RTP_MIN=10000
JANUS_UDP_RTP_MAX=10200

# Generate these once with ./generate-janus-tokens.sh
JANUS_API_TOKEN=2008c1ca-bc7a-4494-9bb5-cfa888b9b131
JANUS_ADMIN_TOKEN=d1d67635-a0bb-49d5-960b-7ff6b820ffbc

# ---------------------------
# MariaDB SETTINGS
# ---------------------------
MARIADB_HOST=mariadb
MARIADB_DATABASE=opensim
MARIADB_USER=opensim

